# Copy to .env.development for local work. When this file exists, `npm start` uses it instead of .env,
# so nothing done while developing touches the live database.
PORT=3000
NODE_ENV=development
SITE_URL=http://localhost:3000

# A separate test database (for example a free Atlas M0 cluster). Never the live one.
MONGO_URI=

# Any long random value for local sign-in
JWT_SECRET=

# Local key; the test data is encrypted with it
DATA_ENCRYPTION_KEY=

REQUIRE_2FA=off

# Creates a first admin in the test database
ADMIN_EMAIL=
ADMIN_PASSWORD=
