PORT=3000
NODE_ENV=production
SITE_URL=https://www.nibras-ac.com

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# MongoDB Atlas connection. MONGO_URI_FALLBACK is optional (direct replica set URI).
MONGO_URI=
MONGO_URI_FALLBACK=

# Used once to create the first admin, then the password can be removed
ADMIN_EMAIL=
ADMIN_PASSWORD=

# SMTP for contact notifications and password reset
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=

# Encrypts identity numbers and 2FA secrets in the database. 32 random bytes as hex.
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep a safe copy: data encrypted with it cannot be read without it.
DATA_ENCRYPTION_KEY=

# Who must turn on two-factor sign-in: off, admins, or staff
REQUIRE_2FA=off

# Vercel Cron sends this as a Bearer token to /api/v2/cron/reminders (daily follow-up reminders)
CRON_SECRET=

# Shared with the local attendance server inside the academy (local-server/config.json "syncSecret").
# Needed only for offline attendance. 48+ random bytes as hex.
ATTENDANCE_SYNC_SECRET=
