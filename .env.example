PORT=3000
NODE_ENV=production
SITE_URL=https://www.nibras-ac.com

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# MongoDB Atlas connection. MONGO_URI_FALLBACK is optional (direct replica set URI).
MONGO_URI=
MONGO_URI_FALLBACK=

# Used once to create the first admin, then the password can be removed
ADMIN_EMAIL=
ADMIN_PASSWORD=

# SMTP for contact notifications and password reset
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
