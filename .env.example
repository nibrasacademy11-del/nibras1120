# The server's settings: /var/www/nibras/.env on the Hostinger VPS (docs/DEPLOY-VPS.md step 3)
NODE_ENV=production
PORT=3000
SITE_URL=https://www.nibras-ac.com

# The two addresses (docs/DOMAINS.md)
STAFF_HOST=staff.nibras-ac.com
CMS_HOST=
# Staff sign-in works across staff.* (the customers' cookie on www stays separate)
STAFF_COOKIE_DOMAIN=.nibras-ac.com

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# The database on the same server (one-node replica set, see deploy/setup-server.sh)
MONGO_URI=mongodb://127.0.0.1:27017/nibras?replicaSet=rs0

# SMTP: the academy's Hostinger email (notifications, receipts, reminders, password reset)
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=

# Encrypts identity numbers and 2FA secrets in the database. 32 random bytes as hex.
# Moving from Vercel: the SAME value as there. New install: generate once with
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep a safe copy: data encrypted with it cannot be read without it.
DATA_ENCRYPTION_KEY=

# Who must turn on two-factor sign-in: off, admins, or staff
REQUIRE_2FA=admins

# Zoom Server-to-Server OAuth app (docs/DEPLOY-ERP.md); without it lecture links are pasted by hand
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_HOST_USER=

# The hourly jobs run inside the app; JOBS=off stops them. CRON_SECRET (optional) lets you run them
# by hand: curl -H "Authorization: Bearer <secret>" http://127.0.0.1:3000/api/v2/cron/reminders
JOBS=
CRON_SECRET=

# Shared with the local attendance server inside the academy (local-server/config.json "syncSecret").
# Needed only for offline attendance. 48+ random bytes as hex.
ATTENDANCE_SYNC_SECRET=

# Encrypts manual database backups (tools/backup-now.js). Keep an offline copy.
BACKUP_PASSPHRASE=
