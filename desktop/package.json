{
  "name": "nibras-admin-desktop",
  "productName": "Nibras Admin",
  "version": "1.0.0",
  "description": "Desktop window for the Nibras academy admin portal (same server and data)",
  "main": "main.js",
  "private": true,
  "author": "Nibras Academy",
  "scripts": {
    "start": "electron .",
    "dev": "set NIBRAS_URL=http://localhost:3000&& electron .",
    "dist": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.nibras-ac.admin",
    "productName": "Nibras Admin",
    "files": ["main.js", "preload.js", "offline.html", "icon.png", "config.json"],
    "directories": { "output": "dist" },
    "win": { "target": ["nsis"], "icon": "icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "shortcutName": "Nibras Admin" }
  }
}
